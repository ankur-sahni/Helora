    },
    {
      "id": "agg-packages-wa",
      "name": "Aggregate Packages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 340],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const packages = $input.all().map(i => i.json);\nconst msgData = $('Extract Message').first().json;\nreturn [{ json: { sender_id: msgData.sender_id, message_text: msgData.message_text, packages_data: packages } }];"
      }
    },
    {
      "id": "read-faqs-wa",
      "name": "Read FAQs",
