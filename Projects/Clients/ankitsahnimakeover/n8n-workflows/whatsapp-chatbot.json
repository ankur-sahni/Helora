    {
      "id": "extract-msg-wa",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 340],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const changes = $input.item.json?.entry?.[0]?.changes?.[0]?.value;\nconst messages = changes?.messages;\nif (!messages || messages.length === 0) return [];\nconst msg = messages[0];\nif (msg.type !== 'text') return [];\nreturn { json: { sender_id: msg.from, message_text: msg.text.body } };"
      }
    },
    {
      "id": "read-packages-wa",
      "name": "Read Packages",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [720, 340],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
