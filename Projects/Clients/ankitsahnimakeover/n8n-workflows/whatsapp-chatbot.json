    {
      "id": "agg-faqs-wa",
      "name": "Aggregate FAQs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 340],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const faqs = $input.all().map(i => i.json);\nconst prev = $('Aggregate Packages').first().json;\nreturn [{ json: { sender_id: prev.sender_id, message_text: prev.message_text, packages_data: prev.packages_data, faqs_data: faqs } }];"
      }
    },
    {
      "id": "read-about-wa",
      "name": "Read About",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1680, 340],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
