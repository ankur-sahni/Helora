      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [2880, 200],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads & Bookings",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ new Date().toISOString() }}",
            "Platform": "WhatsApp",
            "Sender ID": "={{ $json.sender_id }}",
            "Intent": "={{ $json.intent }}",
            "Name": "={{ $json.lead_name || '' }}",
            "Service": "={{ $json.lead_service || '' }}",
            "Preferred Date-Time": "={{ $json.lead_datetime || '' }}",
            "Customer Message": "={{ $json.message_text }}"
          }
        },
