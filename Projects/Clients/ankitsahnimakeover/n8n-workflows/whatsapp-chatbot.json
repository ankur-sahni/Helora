            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.sender_id, type: 'text', text: { body: $json.reply } }) }}",
        "options": {}
      }
    }
