    {
      "id": "build-prompt-wa",
      "name": "Build Gemini Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 340],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const aboutRows = $input.all().map(i => i.json);\nconst prev = $('Aggregate FAQs').first().json;\n\nlet aboutText = '';\naboutRows.forEach(row => {\n  const k = row['Key'] || '';\n  const v = row['Value'] || '';\n  if (k && v) aboutText += k + ': ' + v + '\\n';\n});\n\nlet packagesText = '';\nprev.packages_data.forEach(row => {\n  const name = row['Package Name'] || '';\n  const price = row['Price'] || '';\n  const gst = row['GST Note'] || '';\n  const badge = row['Badge'] || '';\n  const inc = (row['Inclusions (semicolon-separated)'] || '').split(';');\n  if (name) {\n    packagesText += '\\n' + name + ' (' + badge + ') - ' + price + ' (' + gst + '):\\n';\n    inc.forEach(item => { const t = item.trim(); if (t) packagesText += '  - ' + t + '\\n'; });\n  }\n});\n\nlet faqsText = '';\nprev.faqs_data.forEach(row => {\n  const q = row['Question'] || '';\n  const a = row['Answer'] || '';\n  if (q && a) faqsText += 'Q: ' + q + '\\nA: ' + a + '\\n\\n';\n});\n\nconst systemPrompt = 'You are a smart, friendly assistant for Ankit Sahni Makeover — Lahar\\'s premier bridal makeup and styling studio.\\n\\nABOUT:\\n' + aboutText + '\\nPACKAGES:\\n' + packagesText + '\\nFAQs:\\n' + faqsText + '\\nRULES:\\n1. Detect if customer writes in Hindi or English. Always reply in the SAME language.\\n2. Classify intent as one of: faq | package_inquiry | appointment_booking | lead | general_chat\\n3. If appointment_booking: ask for name, service, and preferred date/time in your reply.\\n4. Keep replies warm, professional, 3-4 sentences max.\\n5. For unlisted prices say (in detected language): We will share pricing details on WhatsApp at +91 90988 88134.\\n6. End with a soft CTA like: Shall I book a consultation? or Kya main aapke liye appointment book karun?\\n\\nRespond ONLY with valid JSON — no markdown, no backticks:\\n{\"intent\":\"...\",\"reply\":\"...\",\"lead_name\":null,\"lead_service\":null,\"lead_datetime\":null}';\n\nconst geminiBody = JSON.stringify({\n  system_instruction: { parts: [{ text: systemPrompt }] },\n  contents: [{ role: 'user', parts: [{ text: prev.message_text }] }],\n  generationConfig: { temperature: 0.7, maxOutputTokens: 512 }\n});\n\nreturn [{ json: { sender_id: prev.sender_id, message_text: prev.message_text, gemini_request_body: geminiBody } }];"
      }
    },
    {
      "id": "call-gemini-wa",
      "name": "Call Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2160, 340],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.gemini_request_body }}",
        "options": {}
      }
    },
    {
      "id": "parse-gemini-wa",
      "name": "Parse Gemini Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2400, 340],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json.candidates?.[0]?.content?.parts?.[0]?.text || '';\nconst cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  parsed = { intent: 'general_chat', reply: 'Thank you for messaging Ankit Sahni Makeover! For quick help, WhatsApp us at +91 90988 88134.', lead_name: null, lead_service: null, lead_datetime: null };\n}\nconst bd = $('Build Gemini Prompt').first().json;\nreturn { json: { ...parsed, sender_id: bd.sender_id, message_text: bd.message_text } };"
      }
    },
    {
      "id": "is-lead-wa",
      "name": "Is Booking or Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [2640, 340],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-booking-wa",
              "leftValue": "={{ $json.intent }}",
              "rightValue": "appointment_booking",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-lead-wa",
              "leftValue": "={{ $json.intent }}",
              "rightValue": "lead",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        }
      }
    },
    {
